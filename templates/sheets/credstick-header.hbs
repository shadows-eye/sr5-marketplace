<span class="credstick-header-control basic-row" style="display: inline-flex; align-items: center; gap: 6px; margin-left: 8px; vertical-align: middle;">
    {{#if (or @root.isEditMode isEditMode)}}
        <label data-tooltip="{{localize 'SR5Marketplace.Marketplace.Credstick.IsCredstickHint'}}" style="display: inline-flex; align-items: center; gap: 4px; cursor: pointer; font-weight: bold; font-size: 12px; margin: 0; color: inherit;">
            <i class="fas fa-yen-sign" style="color: #fbbf24;"></i>
            <span>{{localize 'SR5Marketplace.Marketplace.Credstick.IsCredstick'}}</span>
            <input type="checkbox" class="credstick-toggle-checkbox" name="flags.sr5-marketplace.credstick" {{#if credstickData.credstick}}checked{{/if}} style="margin: 0; cursor: pointer;" />
        </label>
        {{#if credstickData.credstick}}
            <select class="credstick-type-select" name="flags.sr5-marketplace.credstickType" style="font-size: 11px; padding: 2px 6px; margin-left: 4px; border-radius: 4px; background: rgba(0,0,0,0.6); color: #fff; border: 1px solid rgba(255,255,255,0.3);">
                <option value="standard" {{#if (eq credstickData.credstickType "standard")}}selected{{/if}}>{{localize "SR5Marketplace.Marketplace.Credstick.Types.standard"}}</option>
                <option value="silver" {{#if (eq credstickData.credstickType "silver")}}selected{{/if}}>{{localize "SR5Marketplace.Marketplace.Credstick.Types.silver"}}</option>
                <option value="gold" {{#if (eq credstickData.credstickType "gold")}}selected{{/if}}>{{localize "SR5Marketplace.Marketplace.Credstick.Types.gold"}}</option>
                <option value="platinum" {{#if (eq credstickData.credstickType "platinum")}}selected{{/if}}>{{localize "SR5Marketplace.Marketplace.Credstick.Types.platinum"}}</option>
                <option value="ebony" {{#if (eq credstickData.credstickType "ebony")}}selected{{/if}}>{{localize "SR5Marketplace.Marketplace.Credstick.Types.ebony"}}</option>
            </select>
        {{/if}}
    {{else}}
        {{#if credstickData.credstick}}
            <span style="font-size: 11px; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; background: rgba(0,0,0,0.4); padding: 2px 6px; border-radius: 4px;">
                <i class="fas fa-yen-sign" style="color: #fbbf24;"></i>
                <span>{{localize credstickData.preset.labelKey}}</span>
            </span>
        {{/if}}
    {{/if}}
</span>
