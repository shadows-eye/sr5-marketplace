{{#if credstickData.credstick}}
<label class="credstick-footer-control" style="text-wrap: nowrap; display: inline-flex; align-items: center; gap: 4px; margin-left: 8px;">
    <span style="font-weight: bold;">{{localize "SR5Marketplace.Marketplace.Credstick.Balance"}}:</span>
    {{#if (or @root.isEditMode isEditMode)}}
        <input type="number" class="credstick-balance-input short skinny text-center" name="flags.sr5-marketplace.currentValue" value="{{credstickData.currentValue}}" style="width: 70px; text-align: center; color: {{credstickData.balanceColor}}; font-weight: bold;" />
    {{else}}
        <span style="font-weight: bold; color: {{credstickData.balanceColor}};">{{credstickData.currentValue}}</span>
    {{/if}}
    <span style="font-weight: bold;">¥</span>
    <span class="credstick-color-badge inline-block"
          style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {{credstickData.preset.color}}; border: 1px solid rgba(255,255,255,0.4); vertical-align: middle; margin-left: 2px; cursor: help;"
          title="{{localize credstickData.preset.labelKey}} ({{localize 'SR5Marketplace.Marketplace.Credstick.MaxCapacity'}}: {{credstickData.maxValue}} ¥){{#if credstickData.isOverCapacity}} - {{localize 'SR5Marketplace.Marketplace.Credstick.OverCapacity'}}{{/if}}">
    </span>
</label>
{{/if}}
